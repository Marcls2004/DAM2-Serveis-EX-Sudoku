<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://apache.org"
         xmlns:xsi="http://w3.org"
         xsi:schemaLocation="http://apache.org 
                             http://apache.org">
    <modelVersion>4.0.0</modelVersion>
    
    <!-- 
      COORDINADAS DEL PROYECTO 
      Define el empaquetado del juego dentro del ecosistema Maven.
    -->
    <groupId>com.example</groupId>
    <artifactId>project-name</artifactId>
    <version>1.0.0</version>
    
    <!-- PROPIEDADES DEL PROYECTO -->
    <properties>
        <maven.compiler.source>20</maven.compiler.source>
        <maven.compiler.target>20</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        
        <!-- 
          🔍 CAMBIO 1: SE AÑADIÓ ESTA PROPIEDAD GLOBAL 
          Centraliza la versión de los módulos gráficos de JavaFX (Versión 20) 
          para garantizar compatibilidad con tu JDK de compilación.
        -->
        <javafx.version>20</javafx.version>
    </properties>
    
    <!-- DEPENDENCIAS DEL PROYECTO -->
    <dependencies>
        <!-- 
          Componente base de JavaFX (Controles nativos como Button, Label, TextField).
        -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        
        <!-- 
          🟢 CAMBIO 2: SE AÑADIÓ ESTA DEPENDENCIA CRÍTICA (MÓDULO FXML)
          Indispensable para que tu código Java sea capaz de leer, interpretar y renderizar 
          los archivos estructurados '.fxml' que diseñas y guardas desde Scene Builder. 
          Su ausencia provocaba los 12 errores de compilación de paquetes ausentes en Main y Controller.
        -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        
        <!-- 
          🟢 CAMBIO 3: SE AÑADIÓ ESTA LIBRERÍA DE RED DE TERCEROS
          Herramienta nativa 'Java-WebSocket' que levanta los subprocesos e hilos asíncronos 
          en segundo plano para conectar tu SudokuServer y tu WebSocketClient en tiempo real.
        -->
        <dependency>
            <groupId>org.java-websocket</groupId>
            <artifactId>Java-WebSocket</artifactId>
            <version>1.5.4</version>
        </dependency>
    </dependencies>
    
    <!-- CONFIGURACIÓN DEL PROCESO DE COMPILACIÓN -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>--add-opens=java.base/java.lang=ALL-UNNAMED</arg>
                        <arg>--add-opens=java.base/java.nio=ALL-UNNAMED</arg>
                        <arg>--add-opens=java.base/java.util=ALL-UNNAMED</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
    
    <!-- PERFILES DE EJECUCIÓN (PROFILES) -->
    <profiles>
        <profile>
            <id>runMain</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>1.6.0</version>
                        <configuration>
                            <!-- 
                              🔍 CAMBIO 4: SE APUNTÓ EL ENTRY POINT CORRECTO
                              Indica a Maven que al activar el perfil con '-PrunMain' en tu script 
                              'run.ps1', debe iniciar la ejecución exclusivamente a través de la clase 
                              'com.project.Main' que hereda de Application y despliega tus ventanas.
                            -->
                            <mainClass>com.project.Main</mainClass>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
