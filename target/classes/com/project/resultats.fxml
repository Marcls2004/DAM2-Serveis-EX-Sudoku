<?xml version="1.0" encoding="UTF-8"?>

<!-- Importacions obligatòries de JavaFX per gestionar el layout vertical, marges i components de la classificació -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<!-- 
  🟢 CANVI 1: ENLLAÇ OBLIGATORI DEL CONTROLADOR (fx:controller)
  - S'ha afegit 'fx:controller="com.project.Controller"' a la etiqueta arrel VBox.
  - Això va solucionar el bug crític de tipus 'LoadException: No controller specified' que impedia saltar a aquesta finestra.
  - Configura un disseny vertical centrat ('CENTER') de 400x420 amb un espaiat intern entre blocs de 15px.
-->
<VBox alignment="CENTER" prefHeight="420.0" prefWidth="400.0" spacing="15.0" 
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.project.Controller">
    
    <!-- Marges de coixí protectors de 20px a tots els costats per evitar que els elements es peguin al contorn -->
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    
    <children>
        <!-- Títol principal de la finestra estilitzat amb una mida de font de 18px i lletra en negreta -->
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="🏆 Resultados Finales de la Partida 🏆" />
        
        <!-- Subtítol indicador per a la secció de marcadors -->
        <Label text="Clasificación de Jugadores:" />
        
        <!-- 
          🟢 CANVI 2: LLISTA DE RESULTATS FINALS SEPARADA (ListView)
          - Component connectat a 'fx:id="listaPuntuacionesResultados"'.
          - S'ha configurat 'VBox.vgrow="ALWAYS"' per a que ocupi tot l'alt disponible de forma adaptativa.
          - Al tenir un mètode 'actualizarListas' que omple aquesta llista i la de la Vista 2 alhora mitjançant 
            la xarxa, es resol el bug on es desenganxaven els marcadors en canviar de vista.
        -->
        <ListView fx:id="listaPuntuacionesResultados" VBox.vgrow="ALWAYS" />
        
        <!-- 
          🟢 CANVI 3: BOTÓ DE RETORN ACTIU AL JOC (Button)
          - Es vincula de forma explícita l'esdeveniment de clic al mètode 'onAction="#onVolverAlJuegoClick"'.
          - Executa el canvi d'escena a 'joc.fxml' mantenint el progrés, els colors pastel i els punts intactes.
          - S'aplica un padding proporcional de 8px verticals i 15px horitzontals pel seu disseny pla.
        -->
        <Button onAction="#onVolverAlJuegoClick" style="-fx-padding: 8 15 8 15;" text="Volver al Tablero de Juego" />
    </children>
</VBox>
